# ──────────────────────────────────────────────────────────────
# CasaSTEAM — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ──────────────────────────────────────────────────────────────

# ── Base de datos PostgreSQL ──
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/casasteam

# ── JWT ──
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro

# ── Puerto del servidor Express ──
PORT=3001

# ── Google OAuth 2.0 ──────────────────────────────────────────
# Obtén estas credenciales en: https://console.cloud.google.com/
#   1. Crea un proyecto (o usa uno existente)
#   2. Ve a "APIs y servicios" → "Credenciales"
#   3. Crea credenciales de tipo "ID de cliente OAuth 2.0"
#   4. Tipo de aplicación: "Aplicación web"
#   5. Agrega los orígenes autorizados:
#        http://localhost:3000   (desarrollo)
#        https://tu-dominio.com  (producción)
#   6. Agrega las URI de redireccionamiento (si las usas):
#        http://localhost:3000
#
# GOOGLE_CLIENT_ID  → es PÚBLICO  (va en el HTML, no es secreto)
# GOOGLE_CLIENT_SECRET → es PRIVADO (NO lo expongas nunca en el frontend)
#
# NOTA: Esta integración usa el flujo de ID Token (Google Identity Services).
# El Client Secret NO se necesita para este flujo — solo el Client ID.
# Si en el futuro cambias a OAuth Authorization Code, añade el secret aquí.

GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
